APP_NAME=MaintainFlow
APP_ENV=development
DATABASE_URL=sqlite:///./maintainflow.db

# Extraction: rules (no API required) or openai
LLM_PROVIDER=rules
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Delivery: console (safe demo) or smtp
MAIL_MODE=console
MAIL_FROM=maintenance@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
